[
  {
    "id": "tab-monitoreo-presion",
    "type": "tab",
    "label": "Monitoreo de presión (Modbus RTU)",
    "disabled": false,
    "info": "Plantilla de AutomatizaLab (controltrazado.com). Antes de desplegar:\n1) Instalá el paquete node-red-contrib-modbus desde Manage Palette.\n2) Instalá node-red-dashboard si querés el gauge/chart.\n3) Editá el nodo 'Config: sensor presión' con el puerto serial, dirección de esclavo y registro de tu sensor real.\n4) Ajustá la fórmula de conversión de unidades en el nodo 'Convertir a PSI' según la hoja técnica de tu sensor.\n5) Ajustá los umbrales en el nodo 'Evaluar umbrales' (bomba en seco / obstrucción).\nGuía completa: https://www.controltrazado.com/articulos/node-red-modbus-presion-hidroponia"
  },
  {
    "id": "cfg-modbus-client",
    "type": "modbus-client",
    "name": "Config: sensor presión",
    "clienttype": "serial",
    "bufferCommands": true,
    "stateLogEnabled": false,
    "tcpHost": "127.0.0.1",
    "tcpPort": "502",
    "tcpType": "DEFAULT",
    "serialPort": "COM3",
    "serialType": "RTU-BUFFERD",
    "serialBaudrate": "9600",
    "serialDatabits": "8",
    "serialStopbits": "1",
    "serialParity": "none",
    "serialConnectionDelay": "100",
    "unit_id": "1",
    "commandDelay": "1",
    "clientTimeout": "1000",
    "reconnectOnTimeout": true,
    "reconnectTimeout": "2000",
    "parallelUnitIdsAllowed": true
  },
  {
    "id": "node-modbus-read",
    "type": "modbus-read",
    "z": "tab-monitoreo-presion",
    "name": "Leer presión (Modbus)",
    "topic": "presion_hidroponia",
    "showStatusActivities": true,
    "showErrors": true,
    "unitid": "1",
    "dataType": "HoldingRegister",
    "adr": "0",
    "quantity": "1",
    "rate": "5",
    "rateUnit": "s",
    "delayOnStart": true,
    "startDelayTime": "1000",
    "server": "cfg-modbus-client",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "x": 180,
    "y": 120,
    "wires": [["node-convertir-psi"], []]
  },
  {
    "id": "node-convertir-psi",
    "type": "function",
    "z": "tab-monitoreo-presion",
    "name": "Convertir a PSI",
    "func": "// Ajustá esta fórmula según la escala de TU sensor (ver hoja técnica).\n// Ejemplo genérico para un registro crudo 0-1000 mapeado a 0-100 PSI:\nconst crudo = msg.payload[0];\nmsg.payload = crudo / 10;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 420,
    "y": 120,
    "wires": [["node-gauge-presion", "node-chart-presion", "node-evaluar-umbrales"]]
  },
  {
    "id": "node-evaluar-umbrales",
    "type": "switch",
    "z": "tab-monitoreo-presion",
    "name": "Evaluar umbrales",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      { "t": "lt", "v": "5", "vt": "num" },
      { "t": "gt", "v": "60", "vt": "num" },
      { "t": "else" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 3,
    "x": 650,
    "y": 200,
    "wires": [["node-alerta-bomba-seco"], ["node-alerta-obstruccion"], []]
  },
  {
    "id": "node-alerta-bomba-seco",
    "type": "change",
    "z": "tab-monitoreo-presion",
    "name": "Armar alerta: bomba en seco",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "⚠️ Presión muy baja — posible bomba trabajando en seco. Valor actual: {{payload}} PSI",
        "tot": "str"
      }
    ],
    "outputs": 1,
    "x": 500,
    "y": 260,
    "wires": [["node-notificacion", "node-cortar-bomba"]]
  },
  {
    "id": "node-alerta-obstruccion",
    "type": "change",
    "z": "tab-monitoreo-presion",
    "name": "Armar alerta: obstrucción",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "⚠️ Presión muy alta — posible obstrucción en el goteo. Valor actual: {{payload}} PSI",
        "tot": "str"
      }
    ],
    "outputs": 1,
    "x": 830,
    "y": 260,
    "wires": [["node-notificacion", "node-cortar-bomba"]]
  },
  {
    "id": "node-notificacion",
    "type": "debug",
    "z": "tab-monitoreo-presion",
    "name": "Notificación (reemplazar por email/Telegram/etc.)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 700,
    "y": 340,
    "wires": []
  },
  {
    "id": "node-cortar-bomba",
    "type": "comment",
    "z": "tab-monitoreo-presion",
    "name": "Opcional: conectar acá un nodo Modbus-Write hacia tu módulo de relé para cortar la bomba automáticamente ante una falla",
    "info": "",
    "x": 950,
    "y": 340,
    "wires": []
  },
  {
    "id": "node-gauge-presion",
    "type": "ui_gauge",
    "z": "tab-monitoreo-presion",
    "name": "Gauge de presión",
    "group": "grupo-hidroponia",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Presión del circuito",
    "label": "PSI",
    "format": "{{value}}",
    "min": 0,
    "max": "100",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "5",
    "seg2": "60",
    "x": 660,
    "y": 100,
    "wires": []
  },
  {
    "id": "node-chart-presion",
    "type": "ui_chart",
    "z": "tab-monitoreo-presion",
    "name": "Tendencia últimas horas",
    "group": "grupo-hidroponia",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Presión en el tiempo",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm",
    "interpolate": "linear",
    "nodata": "",
    "dot": false,
    "ymin": "0",
    "ymax": "100",
    "removeOlder": 1,
    "removeOlderPoints": "",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#1f77b4"],
    "x": 660,
    "y": 140,
    "wires": [[]]
  },
  {
    "id": "grupo-hidroponia",
    "type": "ui_group",
    "name": "Hidroponía — Presión",
    "tab": "ui-tab-hidroponia",
    "order": 1,
    "disp": true,
    "width": "6"
  },
  {
    "id": "ui-tab-hidroponia",
    "type": "ui_tab",
    "name": "Hidroponía",
    "icon": "dashboard",
    "order": 1
  }
]
